# ── Frontend Environment Variables ────────────────────────
# Copy this file to .env and fill in your values
# Vite exposes only variables prefixed with VITE_ to the browser

# Backend API base URL (for local development)
VITE_API_BASE_URL=http://localhost:8000

# Production backend URL (used when not in dev mode and VITE_API_BASE_URL is not set)
VITE_API_PRODUCTION_URL=https://your-production-backend.example.com

# Analytics API key for tracking events
VITE_ANALYTICS_API_KEY=your-api-key-here
