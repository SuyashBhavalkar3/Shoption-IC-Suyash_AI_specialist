# Frontend environment variables for Vite
# Rename this file to .env in local development.

# Base URL for the backend API. Set this in Azure as well.
VITE_API_BASE_URL="https://your-azure-backend-url"

# Optional analytics keys if used by the frontend.
# VITE_API_KEY="your_analytics_api_key"
# VITE_ANALYTICS_API_KEY="your_analytics_api_key"